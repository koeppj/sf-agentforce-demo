    <description>Manual Doc Gen status refresh for an authorized HR intake Case. Calls MyBox_GetCaseDocGenStatus and writes only status, output file Id, and sanitized error code. A blank status preserves prior Case integration status.</description>
    <environments>Default</environments>
    <formulas>
        <name>fDisplayStatus</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Get_DocGen_Status.status})), {!Get_DocGen_Status.status}, {!Get_Case_By_Id.HR_Integration_Status__c})</expression>
    </formulas>
    <formulas>
        <name>fErrorCodeToWrite</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Get_DocGen_Status.errorCode})), {!Get_DocGen_Status.errorCode}, {!vDisplayErrorCode})</expression>
    </formulas>
